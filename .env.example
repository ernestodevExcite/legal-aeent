# Copia este archivo como .env y rellena los valores

# Seguridad — genera una clave con: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=

# Email (opcional, para alertas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Slack (opcional, para alertas)
SLACK_WEBHOOK=

# Email destino de alertas
ALERT_EMAIL=
